    %% Styling Classes
    classDef rootClass fill:#1e3a8a,stroke:#1e40af,stroke-width:2px,color:#ffffff;
    classDef groupClass fill:#dbeafe,stroke:#3b82f6,stroke-width:2px,color:#1e3a8a;
    classDef plainNode fill:#ffffff,stroke:#94a3b8,stroke-width:1.5px,color:#0f172a;

    Root(["Clinical 3D Web System<br/><b>Functional Requirements (Web Platform Scope)</b>"]):::rootClass

    %% Main Modules
    M1["1. Frontend User Experience<br/>(Next.js Client)"]:::groupClass
    M2["2. Backend API & Storage<br/>(FastAPI Service)"]:::groupClass
    M3["3. Pipeline Orchestration<br/>(Integration Layer)"]:::groupClass

    Root --> M1
    Root --> M2
    Root --> M3

    %% Section 1: Frontend User Experience
    M1 --> FR_F01["<b>FR-F01: System Overview & Demos</b><br/>Display 7-stage guide, tech stack & sample datasets (Home)<br/><i>[Priority: Medium]</i>"]:::plainNode
    M1 --> FR_F02["<b>FR-F02: Multi-View Photo Upload UI</b><br/>Drag-and-drop ingestion, 6-12 photos, max 25MB check (Upload.tsx)<br/><i>[Priority: High]</i>"]:::plainNode
    M1 --> FR_F03["<b>FR-F03: Stage 0 Visual Framing Gate</b><br/>Render overlays, Pass/Warning/Reject badges & retake flags (Framing.tsx)<br/><i>[Priority: High]</i>"]:::plainNode
    M1 --> FR_F04["<b>FR-F04: Real-Time Execution Tracking</b><br/>Poll job progress, live status badges & stage logs (Processing.tsx)<br/><i>[Priority: High]</i>"]:::plainNode
    M1 --> FR_F05["<b>FR-F05: Interactive 3D Cut Tool</b><br/>Three.js viewport to adjust anatomical cut plane (Review.tsx)<br/><i>[Priority: High]</i>"]:::plainNode
    M1 --> FR_F06["<b>FR-F06: Metric Dashboard & 3D Viewer</b><br/>Render final 3D model, volume display & CSV/mesh export (Result.tsx)<br/><i>[Priority: High]</i>"]:::plainNode

    %% Section 2: Backend API & Storage
    M2 --> FR_B01["<b>FR-B01: Job Lifecycle REST APIs</b><br/>Provide endpoints to create, monitor & manage jobs (POST /jobs, GET /jobs/:id)<br/><i>[Priority: High]</i>"]:::plainNode
    M2 --> FR_B02["<b>FR-B02: Upload Validation & Storage</b><br/>Enforce constraints, preserve photo order & create unique job directory<br/><i>[Priority: High]</i>"]:::plainNode
    M2 --> FR_B03["<b>FR-B03: Cut Parameter Ingestion</b><br/>Provide POST /recut to ingest plane normal & intercept vectors<br/><i>[Priority: High]</i>"]:::plainNode
    M2 --> FR_B04["<b>FR-B04: Artifact & Static Streaming</b><br/>Stream point clouds, final meshes (.ply/.stl) & volumes.csv to client<br/><i>[Priority: High]</i>"]:::plainNode

    %% Section 3: Pipeline Orchestration & Integration
    M3 --> FR_I01["<b>FR-I01: Asynchronous Subprocess Dispatch</b><br/>Spawn downstream stage scripts via stagerun.py without blocking API loop<br/><i>[Priority: High]</i>"]:::plainNode
    M3 --> FR_I02["<b>FR-I02: Human-in-the-Loop State Machine</b><br/>Halt pipeline at awaiting-cut post Stage 2 until clinician confirms cut<br/><i>[Priority: High]</i>"]:::plainNode
    M3 --> FR_I03["<b>FR-I03: Partial Pipeline Resumption</b><br/>Re-trigger stages 3-6 with --cut-only flag using ingested cut plane<br/><i>[Priority: High]</i>"]:::plainNode
    M3 --> FR_I04["<b>FR-I04: Subprocess Monitoring & Logging</b><br/>Capture stdout/stderr, detect execution failures & update job status<br/><i>[Priority: Medium]</i>"]:::plainNode
