flowchart TD

    User(["User (Cliniciant"])

    subgraph Frontend ["Frontend Client (Next.js - web/)"]
        Page["State Controller & Job State<br/>(page.tsx)"]
        
        subgraph Screens ["UI Screens"]
            Upload["Photo Upload<br/>(Upload.tsx)"]
            Framing["Frame & Coverage Review<br/>(Framing.tsx)"]
            Processing["Progress & Pipeline Status<br/>(Processing.tsx)"]
            Review["Interactive Cut Review<br/>(Review.tsx)"]
            Result["Measurement Results<br/>(Result.tsx)"]
        end

        subgraph Renderers ["3D Viewers & Mesh Loaders"]
            CutViewer["3D Cut Plane Viewer<br/>(CutReview.tsx)"]
            MeshView["3D Mesh Viewer - Three.js<br/>(Viewport / MeshView.tsx)"]
            PlyLoader["PLY Scene Loader<br/>(usePly.ts)"]
        end

        API["Browser API Client<br/>(api.ts)"]
        Data["Artifact Readers<br/>(data.ts)"]
    end

    subgraph BackendServ ["Backend Service (FastAPI - service/)"]
        App["HTTP REST Service<br/>(app.py)"]
        JobRunner["Job Queue & Runner<br/>(jobs.py)"]
        StageRun["Stage Runner Subprocess<br/>(stagerun.py)"]
    end

    subgraph Pipeline ["Clinical Reconstruction Pipeline (Sequential Stages)"]
        S0["Stage 0: Photo Prep & Framing<br/>(stages/prep.py)"]
        S1["Stage 1: VGGT Inference<br/>(stages/inference.py)"]
        S2["Stage 2: Point Cloud Generation<br/>(stages/pointcloud.py)"]
        
        WaitCut{{"Human In-the-Loop<br/>[State: awaiting-cut]"}}
        
        S3["Stage 3: Marker & Band Cleaning<br/>(stages/clean.py)"]
        S4["Stage 4: Mesh Reconstruction<br/>(stages/reconstruct.py)"]
        S5["Stage 5: Mesh Repair & Watertight<br/>(stages/watertight.py)"]
        S6["Stage 6: Volume Calibration<br/>(stages/volume.py)"]
    end

    subgraph AIModels ["Neural Models, Helpers & Workers"]
        VLM["Visual Detector (VLM)<br/>(core/vlm_detect.py)<br/>[GroundingDINO + SAM]"]
        Config["Pipeline Config<br/>(config.py)"]

        subgraph VGGTModel ["VGGT Model (vggt.py)"]
            Aggregator["Feature Aggregator<br/>(aggregator.py)"]
            TransBlock["Transformer Block<br/>(block.py)"]
            DPTHead["DPT Heads: Depth & Point Map<br/>(dpt_head.py)"]
            CameraHead["Camera Head: Pose<br/>(camera_head.py)"]
        end

        SegHelper["Marker Segmentation<br/>(core/segmentation.py)"]
        BandHelper["3D Band Detection<br/>(core/bands3d.py)"]
        ReconsWorker["Reconstruction Worker<br/>(workers/recons_methods_worker.py)"]
        MeshFixWorker["Mesh Repair Worker<br/>(workers/meshfix_worker.py)"]
    end

    Artifacts[("Job Artifacts & Storage<br/>(output/ & checkpoints/)")]

    %% ── Frontend Flow ──
    User --> Page
    Page --> Upload
    Page --> Framing
    Page --> Processing
    Page --> Review
    Page --> Result

    Upload -->|"1. creates job (POST /jobs)"| API
    Framing -->|"2. confirms framing or rebuild"| API
    Processing -->|"polls status (GET /jobs/:id)"| API
    Review --> CutViewer
    CutViewer --> PlyLoader
    Review -->|"4. confirms cut (POST /recut)"| API
    Result --> MeshView
    MeshView --> PlyLoader
    Result -->|"loads results"| Data

    Data -->|"reads CSV & stats"| App
    PlyLoader -->|"fetches scene PLY"| App
    API -->|"HTTP Requests"| App

    %% ── Backend Service Flow ──
    App -->|"submit(job, '0') & '1-6'"| JobRunner
    App -->|"submit(job, '3-6', --cut-only)"| JobRunner
    App -.->|"serves static files"| Artifacts
    JobRunner -->|"spawns: python stagerun.py stage"| StageRun

    %% ── Sequential Pipeline Execution ──
    StageRun --> S0
    S0 -->|"prepped images & masks"| S1
    S1 -->|"point maps & camera poses"| S2
    S2 -->|"writes scene_mesh.ply"| Artifacts
    S2 --> WaitCut

    WaitCut -.->|"sets job state"| JobRunner
    WaitCut ==>|"resumes after POST /recut"| S3

    S3 -->|"cleaned point cloud"| S4
    S4 -->|"raw reconstructed mesh"| S5
    S5 -->|"watertight mesh"| S6
    S6 -->|"writes volumes.csv & final meshes"| Artifacts

    %% ── Submodule Invocations ──
    S0 -.->|"detects objects"| VLM
    S0 -.->|"reads settings"| Config
    S1 -.->|"runs feed-forward"| VGGTModel
    Aggregator --> TransBlock
    S3 -.-> SegHelper
    S3 -.-> BandHelper
    S4 -.-> ReconsWorker
    S5 -.-> MeshFixWorker
