    Root(["Clinical 3D Reconstruction System<br/><b>Functional Requirements</b>"]):::rootClass

    %% Requirement Groups
    G1["1. Data Ingestion & Validation"]:::groupClass
    G2["2. 3D Spatial Reconstruction"]:::groupClass
    G3["3. Human-in-the-Loop Review"]:::groupClass
    G4["4. Mesh Geometry Processing"]:::groupClass
    G5["5. Metric Volume Measurement"]:::groupClass
    G6["6. Job Dispatch & Tracking"]:::groupClass

    Root --> G1
    Root --> G2
    Root --> G3
    Root --> G4
